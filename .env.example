# Free-model AI chain for course generation (server-only).
# At least one key enables real AI generation; with none, the app
# falls back to a built-in sample course so the UI still works.

# Groq (fast, free tier) - https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (free models, failover) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: allow paid OpenRouter models (default: free-only)
OPENROUTER_ALLOW_PAID=false

# --- Hosting "for a few people" (optional, simple gate) ---
# Comma-separated invite codes. Empty = open access.
DL_INVITE_CODES=

# Poly Pizza (optional) - https://poly.pizza/api
# Enables automatic lookup of real CC-licensed 3D models for each lesson.
# Without this key, the curated list in lib/modelSources.ts is used instead.
POLY_PIZZA_API_KEY=

# --- Authentication: Clerk (REQUIRED) ---
# Sign-in is handled by Clerk. Get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Course storage: Supabase (REQUIRED) ---
# Auth is Clerk; data is Supabase. The Clerk-gated /api/courses route uses the
# SERVICE ROLE key server-side (never exposed), scoped to the Clerk user id.
# Get these from Supabase → Project Settings → API. Run supabase/schema.sql once.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
